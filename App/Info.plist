<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>uz.dkx.rema.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>RemaGoogleClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Rema shows your calendar events on the home screen next to reminders.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Rema moves reminders over from the Reminders app when you ask it to.</string>
	<key>NSContactsUsageDescription</key>
	<string>Rema finds birthdays and phone numbers in your contacts when you ask it to.</string>
</dict>
</plist>
