    "You asked for too many codes today. Try again tomorrow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبت رموزًا كثيرة اليوم. حاول مرة أخرى غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute zu viele Codes angefordert. Versuch es morgen noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez demandé trop de codes aujourd’hui. Réessayez demain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вы запросили слишком много кодов. Попробуйте завтра."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ви запросили забагато кодів. Спробуйте завтра."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бугун жуда кўп код сўрадингиз. Эртага уриниб кўринг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun juda ko‘p kod so‘radingiz. Ertaga urinib ko‘ring."
          }
        }
      }
    },
    "You can use your voice": {
