      }
    },
    "Add a widget and the dial with the next reminder will always be in sight.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أداة، وسيبقى القرص مع التذكير القادم أمام عينيك دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Widget hinzu, dann hast du das Zifferblatt mit der nächsten Erinnerung immer im Blick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un widget, le cadran avec le prochain rappel sera toujours sous vos yeux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет, и циферблат с ближайшим напоминанием всегда будет перед глазами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте віджет, і циферблат із найближчим нагадуванням завжди буде перед очима."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет қўшинг, яқин эслатмали циферблат доим кўз олдингизда бўлади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjet qo‘shing, yaqin eslatmali siferblat doim ko‘z oldingizda bo‘ladi."
          }
        }
      }
    },
