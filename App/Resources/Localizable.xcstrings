    "This is the last reminder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا آخر تذكير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die letzte Erinnerung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le dernier rappel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последнее напоминание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це останнє нагадування."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу охирги эслатма."
