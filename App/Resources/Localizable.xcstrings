    "Rema asks only for what it needs. You can change this in the phone settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب Rema الوصول إلى ما يحتاجه فقط. يمكنك تغيير ذلك في إعدادات الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema fragt nur nach dem, was nötig ist. Ändern kannst du das in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema ne demande que ce dont il a besoin. Vous pourrez le changer dans les réglages du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema спросит доступ только к тому, что нужно. Поменять можно в настройках телефона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema попросить доступ лише до того, що потрібно. Змінити можна в налаштуваннях телефона."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema фақат керакли нарсаларга рухсат сўрайди. Буни телефон созламаларида ўзгартириш мумкин."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema faqat kerakli narsalarga ruxsat so‘raydi. Buni telefon sozlamalarida o‘zgartirish mumkin."
          }
        }
      }
    },
    "Rema finds the date, time, repeat and place in the phrase. You can write in eight languages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد Rema في العبارة التاريخ والوقت والتكرار والمكان. يمكنك الكتابة بثماني لغات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema findet im Satz Datum, Uhrzeit, Wiederholung und Ort. Du kannst in acht Sprachen schreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema trouve dans la phrase la date, l’heure, la répétition et le lieu. Vous pouvez écrire en huit langues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema сама найдёт во фразе дату, время, повтор и место. Писать можно на восьми языках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema сама знайде у фразі дату, час, повтор і місце. Писати можна вісьмома мовами."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema иборадан сана, вақт, такрор ва жойни ўзи топади. Саккиз тилда ёзиш мумкин."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema iboradan sana, vaqt, takror va joyni o‘zi topadi. Sakkiz tilda yozish mumkin."
          }
        }
      }
    },
