    "This version is out of date. Install the new one from the App Store, it takes a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإصدار قديم. ثبّت الإصدار الجديد من App Store، لن يستغرق ذلك سوى دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version ist veraltet. Installiere die neue aus dem App Store, das dauert eine Minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version est obsolète. Installez la nouvelle depuis l’App Store, cela prend une minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия устарела. Поставьте новую из App Store, это займёт минуту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця версія застаріла. Встановіть нову з App Store, це займе хвилину."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу версия эскирган. App Store’дан янгисини ўрнатинг, бир дақиқа вақт олади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu versiya eskirgan. App Store’dan yangisini o‘rnating, bir daqiqa vaqt oladi."
          }
        }
      }
    },
    "Through Do Not Disturb": {
