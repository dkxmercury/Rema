          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour dicter des rappels, autorisez l’accès au micro dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы диктовать напоминания, разрешите доступ к микрофону в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб диктувати нагадування, дозвольте доступ до мікрофона в Параметрах."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Эслатмаларни айтиб ёзиш учун Созламаларда микрофонга рухсат беринг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatmalarni aytib yozish uchun Sozlamalarda mikrofonga ruxsat bering."
          }
        }
      }
    },
