    "A quick look at what you can turn on and where to find it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرة سريعة على ما يمكنك تفعيله وأين تجده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz, was du einschalten kannst und wo du es findest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bref, ce que vous pouvez activer et où le trouver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротко о том, что можно включить и где это найти."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротко про те, що можна ввімкнути і де це знайти."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Нимани ёқиш мумкин ва уни қаердан топиш ҳақида қисқача."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimani yoqish mumkin va uni qayerdan topish haqida qisqacha."
          }
        }
      }
    },
    "A reminder by place comes even when Rema is closed. Just keep location access on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل التذكير حسب المكان حتى عندما يكون Rema مغلقًا. فقط لا تُوقف إذن الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung nach Ort kommt auch, wenn Rema geschlossen ist. Lass nur den Standortzugriff an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel selon le lieu arrive même quand Rema est fermé. Gardez juste l’accès à la localisation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание по месту придёт, даже когда Rema закрыта. Только не отключайте доступ к геопозиции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування за місцем прийде, навіть коли Rema закрита. Тільки не вимикайте доступ до геопозиції."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Жойга кўра эслатма Rema ёпиқ бўлса ҳам келади. Фақат жойлашувга рухсатни ўчирманг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Joyga ko‘ra eslatma Rema yopiq bo‘lsa ham keladi. Faqat joylashuvga ruxsatni o‘chirmang."
          }
        }
      }
    },
