    "Reminders already on this phone will move to the new account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتقل التذكيرات الموجودة على الهاتف إلى الحساب الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen, die schon auf diesem Telefon sind, ziehen ins neue Konto um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels déjà présents sur ce téléphone passeront dans le nouveau compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания, которые уже есть на телефоне, перенесутся в новый аккаунт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування, які вже є на телефоні, перейдуть у новий акаунт."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондаги эслатмалар янги аккаунтга ўтади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondagi eslatmalar yangi akkauntga o‘tadi."
          }
        }
      }
    },
    "Reminders are saved in the account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات محفوظة في الحساب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden im Konto gespeichert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont enregistrés dans le compte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания сохраняются в аккаунте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування зберігаються в акаунті"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Эслатмалар аккаунтда сақланади"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatmalar akkauntda saqlanadi"
          }
        }
      }
    },
    "Reminders that come only at this place will be deleted too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف معه التذكيرات المرتبطة بهذا المكان فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen, die nur an diesen Ort gebunden sind, werden mit gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels liés uniquement à ce lieu seront supprimés avec lui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания только по этому месту удалятся вместе с ним."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування лише за цим місцем видаляться разом із ним."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Фақат шу жойга боғлиқ эслатмалар у билан бирга ўчирилади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat shu joyga bog‘liq eslatmalar u bilan birga o‘chiriladi."
          }
        }
      }
    },
