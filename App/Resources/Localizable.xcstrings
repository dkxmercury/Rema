    "Up to %@, a good time to get outside.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %@، وقت مناسب للخروج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %@, gute Zeit, rauszugehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %@, un bon moment pour sortir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, хорошее время выбраться на улицу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, гарний час вибратися надвір."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ гача, ташқарига чиқиш учун яхши вақт."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gacha, tashqariga chiqish uchun yaxshi vaqt."
          }
        }
      }
    },
    "Up to %@, drink more water.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %@، اشرب ماء أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %@, trink mehr Wasser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %@, buvez beaucoup d’eau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, пейте больше воды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, пийте більше води."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ гача, кўпроқ сув ичинг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gacha, ko‘proq suv iching."
          }
        }
      }
    },
    "Up to 20 places. Any name, only you see it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 20 مكانًا. أي اسم، وتراه أنت فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 20 Orte. Beliebiger Name, nur du siehst ihn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 20 lieux. Nom libre, vous seul le voyez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мест до 20. Название любое, его видите только вы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До 20 місць. Назва будь-яка, її бачите тільки ви."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "20 тагача жой. Номи исталган, уни фақат сиз кўрасиз."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "20 tagacha joy. Nomi istalgan, uni faqat siz ko‘rasiz."
          }
        }
      }
    },
    "Up to three. They appear as buttons in the notification.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى ثلاثة. تظهر كأزرار في الإشعار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu drei. Sie erscheinen als Tasten in der Mitteilung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à trois. Ils apparaissent comme boutons dans la notification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До трёх. Они появятся кнопками в уведомлении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До трьох. Вони з’являться кнопками у сповіщенні."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Учтагача. Улар билдиришномада тугма бўлиб чиқади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchtagacha. Ular bildirishnomada tugma bo‘lib chiqadi."
          }
        }
      }
    },
