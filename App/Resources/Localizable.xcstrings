    },
    "This is the third week in a row you set “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ثالث أسبوع على التوالي تضيف فيه «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon die dritte Woche in Folge legst du „%@“ an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la troisième semaine de suite que vous créez « %@ »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже третью неделю подряд вы ставите «%@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже третій тиждень поспіль ви ставите «%@»."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Сиз «%@»ни учинчи ҳафта кетма-кет қўйяпсиз."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz «%@»ni uchinchi hafta ketma-ket qo‘yyapsiz."
          }
        }
      }
    },
    "This time has already passed": {
      "localizations": {
        "ar": {
          "stringUnit": {
