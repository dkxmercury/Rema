    "Widgets and notifications stay open. If %@ does not work, you can enter the phone passcode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغلق هذا الأدوات والإشعارات. وإن لم يعمل %@ يمكنك إدخال رمز دخول الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets und Mitteilungen bleiben offen. Klappt %@ nicht, kannst du den iPhone-Code eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets et les notifications restent visibles. Si %@ ne fonctionne pas, vous pouvez saisir le code du téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты и уведомления это не закрывает. Если %@ не сработал, можно ввести код телефона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віджети й сповіщення це не закриває. Якщо %@ не спрацював, можна ввести код-пароль телефона."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет ва билдиришномалар ёпилмайди. Агар %@ ишламаса, телефон кодини киритиш мумкин."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjet va bildirishnomalar yopilmaydi. Agar %@ ishlamasa, telefon kodini kiritish mumkin."
          }
        }
      }
    },
