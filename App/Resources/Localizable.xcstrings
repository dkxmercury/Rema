        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „morgens“ und „abends“ und Erinnerungen ohne Uhrzeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour « le matin », « le soir » et les rappels sans heure"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для слов «утром» и «вечером» и напоминаний без часа"
