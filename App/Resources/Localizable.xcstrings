    "By continuing, you agree to the [Terms](https://remaapp.cc/terms/) and the [Privacy Policy](https://remaapp.cc/privacy/).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمتابعة، أنت توافق على [الشروط](https://remaapp.cc/terms/) و[سياسة الخصوصية](https://remaapp.cc/privacy/)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, stimmst du den [Bedingungen](https://remaapp.cc/terms/) und der [Datenschutzerklärung](https://remaapp.cc/privacy/) zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les [Conditions](https://remaapp.cc/terms/) et la [Politique de confidentialité](https://remaapp.cc/privacy/)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы соглашаетесь с [Условиями](https://remaapp.cc/ru/terms/) и [Политикой конфиденциальности](https://remaapp.cc/ru/privacy/)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуючи, ви погоджуєтеся з [Умовами](https://remaapp.cc/terms/) і [Політикою конфіденційності](https://remaapp.cc/privacy/)."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Давом этиб, сиз [Шартлар](https://remaapp.cc/terms/) ва [Махфийлик сиёсати](https://remaapp.cc/privacy/) билан рози бўласиз."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Davom etib, siz [Shartlar](https://remaapp.cc/terms/) va [Maxfiylik siyosati](https://remaapp.cc/privacy/) bilan rozi bo‘lasiz."
          }
