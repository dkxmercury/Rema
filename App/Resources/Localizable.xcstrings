    "No access to location, so place reminders will not come.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا وصول إلى الموقع، لذلك لن تصل التذكيرات حسب المكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf den Standort, ortsbezogene Erinnerungen kommen nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès à la localisation, les rappels selon le lieu n’arriveront pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к геопозиции, напоминания по месту не придут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до геопозиції, нагадування за місцем не прийдуть."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Жойлашувга рухсат йўқ, жойга кўра эслатмалар келмайди."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Joylashuvga ruxsat yo‘q, joyga ko‘ra eslatmalar kelmaydi."
          }
        }
      }
    },
