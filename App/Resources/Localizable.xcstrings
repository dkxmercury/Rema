          "stringUnit": {
            "state": "translated",
            "value": "На %@ холодніше, ніж напередодні."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Олдинги кундан %@ совуқроқ."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldingi kundan %@ sovuqroq."
          }
        }
      }
    },
