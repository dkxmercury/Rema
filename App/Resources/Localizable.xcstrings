          }
        }
      }
    },
    "Hold the plus and talk. Let go when you are done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على + وتكلم. ارفع إصبعك عند الانتهاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Plus gedrückt und sprich. Lass los, wenn du fertig bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le plus et parlez. Relâchez quand vous avez fini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте плюс и говорите. Отпустите, когда закончите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте плюс і говоріть. Відпустіть, коли закінчите."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюсни босиб туринг ва гапиринг. Тугатгач қўйиб юборинг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Plyusni bosib turing va gapiring. Tugatgach qo‘yib yuboring."
          }
        }
      }
    },
    "Hold the plus on the home screen and talk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على زر الإضافة في الشاشة الرئيسية وتكلم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Plus auf dem Startbildschirm gedrückt und sprich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le plus sur l’écran d’accueil et parlez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте плюс на главном экране и говорите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте плюс на головному екрані й говоріть."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош экрандаги плюсни босиб туринг ва гапиринг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosh ekrandagi plyusni bosib turing va gapiring."
          }
        }
      }
    },
    "Hold the plus on the home screen and talk. Let go when you are done, and Rema will make sense of the phrase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على زر الإضافة في الشاشة الرئيسية وتكلم. ارفع إصبعك عند الانتهاء وسيفهم Rema العبارة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Plus auf dem Startbildschirm gedrückt und sprich. Lass los, wenn du fertig bist, Rema versteht den Satz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le plus sur l’écran d’accueil et parlez. Relâchez quand vous avez fini, Rema comprendra la phrase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте плюс на главном экране и говорите. Отпустите, когда закончите, и Rema разберёт фразу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте плюс на головному екрані й говоріть. Відпустіть, коли закінчите, і Rema розбере фразу."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош экрандаги плюсни босиб туринг ва гапиринг. Тугатгач қўйиб юборинг, Rema иборани ўзи тушунади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosh ekrandagi plyusni bosib turing va gapiring. Tugatgach qo‘yib yuboring, Rema iborani o‘zi tushunadi."
          }
        }
      }
    },
