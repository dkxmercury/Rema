    "Open it with %@. Reminders come as usual.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتحه باستخدام %@. تصل التذكيرات كالمعتاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es mit %@. Erinnerungen kommen wie gewohnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le avec %@. Les rappels arrivent comme d’habitude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте её с помощью %@. Напоминания приходят как обычно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте її за допомогою %@. Нагадування приходять як завжди."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Уни %@ билан очинг. Эслатмалар одатдагидек келади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni %@ bilan oching. Eslatmalar odatdagidek keladi."
          }
        }
      }
    },
    "Opens Rema already listening.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Rema ويبدأ الاستماع فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema öffnet sich und hört sofort zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema s’ouvre et commence à écouter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema откроется и сразу начнёт слушать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema відкриється й одразу почне слухати."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema очилади ва дарҳол тинглай бошлайди."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema ochiladi va darhol tinglay boshlaydi."
          }
        }
      }
    },
