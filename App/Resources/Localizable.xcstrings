    "After you sign out, reminders disappear from this phone and come back the next time you sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تسجيل الخروج تختفي التذكيرات من هذا الهاتف وتعود عند تسجيل الدخول التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Abmelden verschwinden die Erinnerungen von diesem Telefon und kommen bei der nächsten Anmeldung zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la déconnexion, les rappels disparaissent de ce téléphone et reviennent à la prochaine connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выхода напоминания пропадут с этого телефона и вернутся при следующем входе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після виходу нагадування зникнуть із цього телефона й повернуться під час наступного входу."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Чиққанингиздан кейин эслатмалар бу телефондан йўқолади ва кейинги киришда қайтади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiqqaningizdan keyin eslatmalar bu telefondan yo‘qoladi va keyingi kirishda qaytadi."
          }
        }
      }
    },
