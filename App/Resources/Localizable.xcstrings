    "We sent a 6-digit code to %@. It works for 15 minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا رمزًا من 6 أرقام إلى %@. يعمل لمدة 15 دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben einen 6-stelligen Code an %@ geschickt. Er gilt 15 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un code à 6 chiffres à %@. Il est valable 15 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили шестизначный код на %@. Он действует 15 минут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надіслали шестизначний код на %@. Він діє 15 хвилин."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ манзилига 6 хонали код юбордик. У 15 дақиқа амал қилади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ manziliga 6 xonali kod yubordik. U 15 daqiqa amal qiladi."
          }
        }
      }
    },
    "We will send an email with a link. Use it to set a new password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنرسل رسالة فيها رابط. استخدمه لتعيين كلمة مرور جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir schicken dir eine E-Mail mit einem Link. Damit legst du ein neues Passwort fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un e-mail avec un lien. Il vous permettra de choisir un nouveau mot de passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришлём письмо со ссылкой. По ней вы зададите новый пароль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішлемо лист із посиланням. За ним ви задасте новий пароль."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳаволали хат юборамиз. У орқали янги пароль ўрнатасиз."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Havolali xat yuboramiz. U orqali yangi parol o‘rnatasiz."
          }
        }
      }
    },
