        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб не втратити нагадування"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Эслатмалар йўқолмаслиги учун киринг"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatmalar yo‘qolmasligi uchun kiring"
          }
        }
      }
    },
    "Sign in to this account on another phone and your reminders will appear there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى هذا الحساب على هاتف آخر وستظهر تذكيراتك هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf einem anderen Telefon mit diesem Konto an, dann erscheinen deine Erinnerungen dort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à ce compte sur un autre téléphone et vos rappels y apparaîtront."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в этот аккаунт на другом телефоне, и напоминания появятся там."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у цей акаунт на іншому телефоні, і нагадування з’являться там."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Шу аккаунтга бошқа телефонда киринг, эслатмалар у ерда пайдо бўлади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu akkauntga boshqa telefonda kiring, eslatmalar u yerda paydo bo‘ladi."
          }
        }
      }
    },
