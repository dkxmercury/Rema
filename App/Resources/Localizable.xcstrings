    "If it is not in your inbox, look in spam. You can send it again in a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تجدها في البريد الوارد، فابحث في البريد العشوائي. يمكنك الإرسال مرة أخرى بعد دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sie nicht im Posteingang ist, schau in den Spam. In einer Minute kannst du sie noch einmal senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il n’est pas dans votre boîte de réception, regardez dans les spams. Vous pourrez le renvoyer dans une minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если его нет во «Входящих», загляните в «Спам». Отправить ещё раз можно через минуту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо його немає у «Вхідних», загляньте в «Спам». Надіслати ще раз можна за хвилину."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Агар у «Кирувчи»да бўлмаса, «Спам»ни текширинг. Бир дақиқадан кейин яна юбориш мумкин."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar u «Kiruvchi»da bo‘lmasa, «Spam»ni tekshiring. Bir daqiqadan keyin yana yuborish mumkin."
          }
        }
      }
    },
