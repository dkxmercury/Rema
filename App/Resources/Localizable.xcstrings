    "“%@” keeps being put off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» يُؤجَّل في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird immer wieder verschoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est sans cesse reporté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» всё время откладывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» весь час відкладається."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» доим кейинга сурилмоқда."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» doim keyinga surilmoqda."
          }
        }
      }
    },
    "“Urgent” gets through Do Not Disturb and Focus. Add the word “urgent” to the phrase or turn it on in the reminder itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة «عاجل» تتجاوز «عدم الإزعاج» و«التركيز». أضف كلمة «عاجل» إلى العبارة أو فعّلها في التذكير نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dringend“ kommt auch bei „Nicht stören“ und Fokus durch. Füge das Wort „dringend“ in den Satz ein oder schalte es in der Erinnerung ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mention « Urgent » passe outre Ne pas déranger et Concentration. Ajoutez le mot « urgent » à la phrase ou activez-la dans le rappel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пометка «Срочно» пробивает «Не беспокоить» и Фокус. Добавьте во фразу слово «срочно» или включите пометку в самом напоминании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначка «Терміново» пробиває «Не турбувати» і «Зосередження». Додайте у фразу слово «терміново» або ввімкніть позначку в самому нагадуванні."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Шошилинч» белгиси «Безовта қилинмасин» ва «Фокус» режимларидан ҳам ўтади. Иборага «шошилинч» сўзини қўшинг ёки эслатманинг ўзида ёқинг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Shoshilinch» belgisi «Bezovta qilinmasin» va «Fokus» rejimlaridan ham o‘tadi. Iboraga «shoshilinch» so‘zini qo‘shing yoki eslatmaning o‘zida yoqing."
          }
        }
      }
    }
  },
  "version": "1.0"
}
