    "mp3, m4a or wav will do. Files longer than 30 seconds are trimmed, iOS requires it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناسب ملفات mp3 أو m4a أو wav. الملفات الأطول من 30 ثانية تُقص، هذا ما يتطلبه iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "mp3, m4a oder wav gehen. Dateien über 30 Sekunden werden gekürzt, das verlangt iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mp3, m4a ou wav conviennent. Les fichiers de plus de 30 secondes sont coupés, iOS l’exige."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подойдёт mp3, m4a или wav. Файл длиннее 30 секунд обрежем, так требует iOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підійде mp3, m4a або wav. Файл довший за 30 секунд обріжемо, так вимагає iOS."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "mp3, m4a ёки wav мос келади. 30 сониядан узун файл қисқартирилади, бу iOS талаби."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "mp3, m4a yoki wav mos keladi. 30 soniyadan uzun fayl qisqartiriladi, bu iOS talabi."
          }
        }
      }
    },
