    "Rema will tell you about rain, snow or frost the evening before and in the morning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيخبرك Rema بالمطر أو الثلج أو الصقيع في المساء السابق وفي الصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema sagt dir am Vorabend und am Morgen Bescheid, wenn Regen, Schnee oder Frost kommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema vous préviendra de la pluie, de la neige ou du gel la veille au soir et le matin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema подскажет про дождь, снег или мороз накануне вечером и утром."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema підкаже про дощ, сніг чи мороз напередодні ввечері й уранці."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema ёмғир, қор ёки аёз ҳақида олдинги кечқурун ва эрталаб айтиб туради."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema yomg‘ir, qor yoki ayoz haqida oldingi kechqurun va ertalab aytib turadi."
          }
        }
      }
    },
