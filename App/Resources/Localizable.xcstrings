    "iPhone watches at most 20 places at once, so this reminder may not come by place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب iPhone عشرين مكانًا كحد أقصى في وقت واحد، لذلك قد لا يصل هذا التذكير حسب المكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone überwacht höchstens 20 Orte gleichzeitig, diese Erinnerung kommt nach Ort vielleicht nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone surveille au plus 20 lieux à la fois, ce rappel pourrait ne pas arriver selon le lieu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone следит не больше чем за 20 местами сразу, это напоминание может не прийти по месту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone стежить не більш ніж за 20 місцями одночасно, це нагадування може не прийти за місцем."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone бир вақтда 20 тадан ортиқ жойни кузатмайди, бу эслатма жойга кўра келмаслиги мумкин."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone bir vaqtda 20 tadan ortiq joyni kuzatmaydi, bu eslatma joyga ko‘ra kelmasligi mumkin."
          }
        }
      }
    },
