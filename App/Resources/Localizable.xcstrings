        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort muss mindestens 8 Zeichen haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe doit contenir au moins 8 caractères."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В пароле должно быть не меньше 8 знаков."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У паролі має бути щонайменше 8 знаків."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль камида 8 та белгидан иборат бўлиши керак."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Parol kamida 8 ta belgidan iborat bo‘lishi kerak."
          }
        }
      }
    },
    "The sign-in has expired. Sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل الدخول. سجّل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist abgelaufen. Melde dich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Reconnectez-vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход устарел. Войдите снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід застарів. Увійдіть знову."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Кириш муддати тугади. Қайта киринг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirish muddati tugadi. Qayta kiring."
          }
        }
      }
    },
    "The watch app installs together with Rema. If it is not on your watch, install it in the Watch app on your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُثبَّت تطبيق الساعة مع Rema. وإن لم يكن على ساعتك فثبّته من تطبيق Watch على iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr-App wird mit Rema installiert. Fehlt sie auf deiner Uhr, installiere sie in der Watch-App auf dem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app pour la montre s’installe avec Rema. Si elle n’est pas sur votre montre, installez-la depuis l’app Watch sur l’iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение для часов ставится вместе с Rema. Если его нет на часах, установите его в приложении Watch на iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок для годинника встановлюється разом із Rema. Якщо його немає на годиннику, встановіть його в застосунку Watch на iPhone."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Соат учун илова Rema билан бирга ўрнатилади. Агар соатда бўлмаса, уни iPhone’даги Watch иловасида ўрнатинг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Soat uchun ilova Rema bilan birga o‘rnatiladi. Agar soatda bo‘lmasa, uni iPhone’dagi Watch ilovasida o‘rnating."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المظهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Мавзу"
          }
        },
        "uz-Latn": {
          "stringUnit": {
