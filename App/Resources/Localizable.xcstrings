    "Down to %@, dress warmer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى %@، البس ملابس أدفأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %@, zieh dich warm an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %@, couvrez-vous bien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, одевайтесь теплее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@, одягайтеся тепліше."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ гача, иссиқроқ кийининг."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gacha, issiqroq kiyining."
          }
        }
      }
    },
    "Dress warmer and enjoy it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البس ملابس أدفأ واستمتع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh dich warm an und genieß es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvrez-vous et profitez-en."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одевайтесь теплее и радуйтесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одягайтеся тепліше й радійте."
