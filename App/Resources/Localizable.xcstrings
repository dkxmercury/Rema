    "When a reminder is less than an hour away, close Rema. The countdown shows up at the top of the screen and on the Lock Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يبقى أقل من ساعة على التذكير، صغّر Rema. سيظهر العد التنازلي أعلى الشاشة وعلى شاشة القفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist eine Erinnerung weniger als eine Stunde entfernt, schließ Rema. Der Countdown erscheint oben auf dem Bildschirm und auf dem Sperrbildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un rappel arrive dans moins d’une heure, fermez Rema. Le compte à rebours s’affiche en haut de l’écran et sur l’écran verrouillé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда до напоминания меньше часа, сверните Rema. Отсчёт появится наверху экрана и на экране блокировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли до нагадування менше години, згорніть Rema. Відлік з’явиться вгорі екрана й на замкненому екрані."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Эслатмагача бир соатдан кам қолганда Rema’ни ёпинг. Ҳисоб экран тепасида ва қулф экранида кўринади."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatmagacha bir soatdan kam qolganda Rema’ni yoping. Hisob ekran tepasida va qulf ekranida ko‘rinadi."
          }
        }
      }
    },
