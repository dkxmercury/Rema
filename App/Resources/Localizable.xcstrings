    "in the evening about tomorrow and in the morning about today, only when there is a reason": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساءً عن الغد وصباحًا عن اليوم، فقط عند وجود سبب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "abends für morgen und morgens für heute, nur wenn es einen Grund gibt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le soir pour le lendemain et le matin pour la journée, seulement s’il y a une raison"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "вечером про завтра и утром про сегодня, только когда есть повод"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "увечері про завтра й уранці про сьогодні, лише коли є привід"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "кечқурун эртанги кун ҳақида, эрталаб бугун ҳақида, фақат сабаб бўлса"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "kechqurun ertangi kun haqida, ertalab bugun haqida, faqat sabab bo‘lsa"
          }
        }
      }
    },
