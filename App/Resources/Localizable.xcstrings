    "Sign in to keep your reminders": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول للاحتفاظ بتذكيراتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Erinnerungen zu behalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
