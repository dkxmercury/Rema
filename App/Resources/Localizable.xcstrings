    "Tells what is next and how soon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بما هو التالي ومتى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt, was als Nächstes kommt und wann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ce qui vient et dans combien de temps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит, что дальше и через сколько."
          }
        },
        "uk": {
