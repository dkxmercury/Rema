    "Adds a reminder from a phrase, for example tomorrow at 9 call mom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف تذكيرًا من عبارة، مثل «غدًا في 9 اتصل بأمي»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine Erinnerung aus einem Satz hinzu, zum Beispiel „morgen um 9 Mama anrufen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un rappel à partir d’une phrase, par exemple « demain à 9 h appeler maman »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет напоминание из фразы, например «завтра в 9 позвонить маме»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає нагадування з фрази, наприклад «завтра о 9 подзвонити мамі»."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Иборадан эслатма қўшади, масалан «эртага соат 9 да онамга қўнғироқ қилиш»."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Iboradan eslatma qo‘shadi, masalan «ertaga soat 9 da onamga qo‘ng‘iroq qilish»."
          }
        }
      }
    },
