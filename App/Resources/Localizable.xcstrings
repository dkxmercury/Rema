    "Allow microphone access in Settings to dictate reminders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون في الإعدادات لإملاء التذكيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
