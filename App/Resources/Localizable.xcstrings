    "Add a time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف وقتًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit hinzufügen"
          }
        },
        "fr": {
