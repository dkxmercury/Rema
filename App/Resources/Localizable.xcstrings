    "%@ colder than the day before.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبرد بـ%@ من اليوم السابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kälter als am Vortag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de moins que la veille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ холоднее, чем накануне."
          }
        },
